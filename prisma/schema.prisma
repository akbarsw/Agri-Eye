// Prisma schema for AGRI-EYE MVP
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FARMER
  BUYER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum BatchStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  NEEDS_REVISION
  REJECTED
  LISTED
  SOLD_OUT
}

enum ProductGrade {
  A
  B
  C
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmer Farmer?
  buyer  Buyer?
}

model Farmer {
  id                 String             @id @default(cuid())
  userId             String             @unique
  phone              String?
  address            String?
  location           String?
  farmSize           Float?
  mainCommodities    String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  batches HarvestBatch[]
  orders  Order[]
}

model Buyer {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String
  businessType String?
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model HarvestBatch {
  id             String       @id @default(cuid())
  farmerId       String
  batchCode      String       @unique
  commodityName  String
  harvestDate    DateTime
  quantity       Float
  unit           String       @default("kg")
  pricePerUnit   Int?
  location       String?
  description    String?
  photoUrl       String?
  grade          ProductGrade?
  status         BatchStatus  @default(PENDING_REVIEW)
  adminNote      String?
  qrCodeUrl      String?
  tracePublicUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  farmer   Farmer     @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orders   Order[]
  traceLogs TraceLog[]
}

model Order {
  id          String      @id @default(cuid())
  buyerId     String
  farmerId    String
  batchId     String
  quantity    Float
  unit        String      @default("kg")
  totalPrice  Int?
  status      OrderStatus @default(REQUESTED)
  buyerNote   String?
  adminNote   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  buyer  Buyer        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  farmer Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  batch  HarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model TraceLog {
  id          String   @id @default(cuid())
  batchId     String
  title       String
  description String?
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  batch HarvestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}
